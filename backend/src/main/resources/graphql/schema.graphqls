"ISO-8601 timestamp, serialised in UTC"
scalar DateTime

"ISO-8601 calendar date (YYYY-MM-DD)"
scalar Date

type Query {
    "The authenticated user, or null when anonymous."
    me: User

    # ---- Public vehicle catalogue
    vehicles(filter: VehicleFilter, page: Int = 0, size: Int = 12, sort: VehicleSort = NEWEST): VehiclePage!
    vehicleBySlug(slug: String!): Vehicle
    vehicleMakes: [String!]!

    # ---- Public service catalogue
    serviceCategories: [ServiceCategory!]!
    services(categorySlug: String): [Service!]!
    serviceBySlug(slug: String!): Service

    # ---- Public rental catalogue
    rentalVehicles(page: Int = 0, size: Int = 12): RentalVehiclePage!
    rentalVehicleBySlug(slug: String!): RentalVehicle
    rentalAvailability(rentalVehicleId: ID!, startDate: Date!, endDate: Date!): RentalAvailability!

    # ---- Public accessories catalogue
    accessories(category: String, page: Int = 0, size: Int = 24): AccessoryPage!

    # ---- Customer account (authenticated)
    myRentalReservations(page: Int = 0, size: Int = 20): ReservationPage!
    myServiceBookings(page: Int = 0, size: Int = 20): ServiceBookingPage!
    myQuotations(page: Int = 0, size: Int = 20): QuotationPage!
    myOrders(page: Int = 0, size: Int = 20): OrderPage!
    myInvoices(page: Int = 0, size: Int = 20): InvoicePage!
    myNotifications(page: Int = 0, size: Int = 20): NotificationPage!
    unreadNotificationCount: Int!

    # ---- Staff (role-checked on the server)
    adminVehicles(filter: AdminVehicleFilter, page: Int = 0, size: Int = 20): VehiclePage!
    adminVehicle(id: ID!): Vehicle
    salesEnquiries(status: EnquiryStatus, page: Int = 0, size: Int = 20): SalesEnquiryPage!
    adminServices: [Service!]!
    contactEnquiries(status: ContactEnquiryStatus, page: Int = 0, size: Int = 20): ContactEnquiryPage!
    adminDashboard: DashboardSummary!
    staffUsers(includeDisabled: Boolean = false): [User!]!
    users(search: String, page: Int = 0, size: Int = 20): UserPage!
    auditLogs(entityType: String, entityId: String, page: Int = 0, size: Int = 50): AuditLogPage!
    adminRentalVehicles(filter: AdminRentalFilter, page: Int = 0, size: Int = 20): RentalVehiclePage!
    adminRentalVehicle(id: ID!): RentalVehicle
    rentalReservations(status: ReservationStatus, page: Int = 0, size: Int = 20): ReservationPage!
    serviceBookings(status: BookingStatus, page: Int = 0, size: Int = 20): ServiceBookingPage!
    workshopCapacity: WorkshopCapacity!
    quotations(status: QuotationStatus, page: Int = 0, size: Int = 20): QuotationPage!
    workshopJobs(status: JobStatus, assignedToUserId: ID, page: Int = 0, size: Int = 20): WorkshopJobPage!
    adminAccessories(search: String, active: Boolean, page: Int = 0, size: Int = 20): AccessoryPage!
    stockMovements(accessoryId: ID!): [StockMovement!]!
    orders(status: OrderStatus, page: Int = 0, size: Int = 20): OrderPage!
    invoices(status: InvoiceStatus, page: Int = 0, size: Int = 20): InvoicePage!
    invoice(id: ID!): Invoice
}

type Mutation {
    register(input: RegisterInput!): AuthPayload!
    login(input: LoginInput!): AuthPayload!

    submitVehicleEnquiry(input: VehicleEnquiryInput!): EnquiryReceipt!
    submitContactEnquiry(input: ContactEnquiryInput!): EnquiryReceipt!
    requestRental(input: ReservationInput!): EnquiryReceipt!
    bookService(input: BookingInput!): EnquiryReceipt!
    requestQuotation(input: QuotationRequestInput!): EnquiryReceipt!

    cancelMyReservation(id: ID!): Reservation!
    cancelMyBooking(id: ID!): ServiceBooking!
    decideQuotation(id: ID!, accept: Boolean!): Quotation!
    placeOrder(input: OrderInput!): EnquiryReceipt!
    cancelMyOrder(id: ID!): Order!
    markNotificationRead(id: ID!): Notification!
    markAllNotificationsRead: Int!

    # ---- Staff (role-checked on the server)
    createVehicle(input: VehicleInput!): Vehicle!
    updateVehicle(id: ID!, input: VehicleInput!): Vehicle!
    setVehicleStatus(id: ID!, status: VehicleStatus!): Vehicle!
    setVehiclePublished(id: ID!, published: Boolean!): Vehicle!
    addVehicleImage(vehicleId: ID!, input: VehicleImageInput!): Vehicle!
    removeVehicleImage(vehicleId: ID!, imageId: ID!): Vehicle!
    updateSalesEnquiry(id: ID!, input: UpdateEnquiryInput!): SalesEnquiry!

    createServiceCategory(input: ServiceCategoryInput!): ServiceCategory!
    updateServiceCategory(id: ID!, input: ServiceCategoryInput!): ServiceCategory!
    createService(input: ServiceInput!): Service!
    updateService(id: ID!, input: ServiceInput!): Service!

    updateContactEnquiryStatus(id: ID!, status: ContactEnquiryStatus!): ContactEnquiry!

    reorderVehicleImages(vehicleId: ID!, imageIds: [ID!]!): Vehicle!

    createStaffUser(input: CreateStaffUserInput!): User!
    setUserRoles(id: ID!, roles: [Role!]!): User!
    setUserEnabled(id: ID!, enabled: Boolean!): User!

    createRentalVehicle(input: RentalVehicleInput!): RentalVehicle!
    updateRentalVehicle(id: ID!, input: RentalVehicleInput!): RentalVehicle!
    setRentalVehicleStatus(id: ID!, status: RentalVehicleStatus!): RentalVehicle!
    setRentalVehiclePublished(id: ID!, published: Boolean!): RentalVehicle!
    addRentalVehicleImage(rentalVehicleId: ID!, input: VehicleImageInput!): RentalVehicle!
    removeRentalVehicleImage(rentalVehicleId: ID!, imageId: ID!): RentalVehicle!
    reorderRentalVehicleImages(rentalVehicleId: ID!, imageIds: [ID!]!): RentalVehicle!
    updateRentalReservation(id: ID!, input: UpdateReservationInput!): Reservation!

    updateServiceBooking(id: ID!, input: UpdateBookingInput!): ServiceBooking!
    setWorkshopCapacity(input: CapacityInput!): WorkshopCapacity!

    priceQuotation(id: ID!, input: QuoteInput!): Quotation!
    cancelQuotation(id: ID!): Quotation!

    createWorkshopJob(input: CreateJobInput!): WorkshopJob!
    updateWorkshopJob(id: ID!, input: UpdateJobInput!): WorkshopJob!
    setWorkshopJobStatus(id: ID!, status: JobStatus!): WorkshopJob!

    createAccessory(input: AccessoryInput!): Accessory!
    updateAccessory(id: ID!, input: AccessoryInput!): Accessory!
    adjustStock(id: ID!, input: StockAdjustInput!): Accessory!
    updateOrder(id: ID!, status: OrderStatus!): Order!

    createInvoice(input: InvoiceInput!): Invoice!
    addInvoiceItem(invoiceId: ID!, input: InvoiceItemInput!): Invoice!
    removeInvoiceItem(invoiceId: ID!, itemId: ID!): Invoice!
    issueInvoice(id: ID!): Invoice!
    voidInvoice(id: ID!): Invoice!
    recordPayment(invoiceId: ID!, input: PaymentInput!): Invoice!
}

# ---------------------------------------------------------------- common

"Monetary amount as a decimal string (never a float) with ISO-4217 currency."
type Money {
    amount: String!
    currency: String!
}

type EnquiryReceipt {
    reference: String!
    message: String!
}

# ---------------------------------------------------------------- auth

enum Role {
    SUPER_ADMIN
    MANAGER
    SALES_AGENT
    RENTAL_AGENT
    SERVICE_ADVISOR
    MECHANIC
    INVENTORY_MANAGER
    FINANCE_OFFICER
    CUSTOMER
}

type User {
    id: ID!
    email: String!
    fullName: String!
    phone: String
    roles: [Role!]!
    staff: Boolean!
    enabled: Boolean!
    lastLoginAt: DateTime
    createdAt: DateTime!
}

type UserPage {
    items: [User!]!
    totalCount: Int!
    page: Int!
    size: Int!
    totalPages: Int!
}

input CreateStaffUserInput {
    email: String!
    fullName: String!
    phone: String
    password: String!
    roles: [Role!]!
}

type AuditLog {
    id: ID!
    action: String!
    entityType: String!
    entityId: String
    details: String
    actorUserId: ID
    actorName: String!
    createdAt: DateTime!
}

type AuditLogPage {
    items: [AuditLog!]!
    totalCount: Int!
    page: Int!
    size: Int!
    totalPages: Int!
}

type DashboardSummary {
    newSalesEnquiries: Int!
    openSalesEnquiries: Int!
    newContactEnquiries: Int!
    vehiclesAvailable: Int!
    vehiclesReserved: Int!
    vehiclesSold: Int!
    vehiclesUnpublished: Int!
    pendingReservations: Int!
    pendingBookings: Int!
    openQuotations: Int!
    activeJobs: Int!
    openOrders: Int!
    unpaidInvoices: Int!
    lowStockItems: Int!
    revenueThisMonth: Money!
    outstandingReceivables: Money!
}

# ---------------------------------------------------------------- notifications

type Notification {
    id: ID!
    type: String!
    title: String!
    body: String!
    link: String
    entityType: String
    entityId: ID
    read: Boolean!
    createdAt: DateTime!
}

type NotificationPage {
    items: [Notification!]!
    totalCount: Int!
    page: Int!
    size: Int!
    totalPages: Int!
}

type AuthPayload {
    token: String!
    expiresAt: DateTime!
    user: User!
}

input RegisterInput {
    email: String!
    password: String!
    fullName: String!
    phone: String
}

input LoginInput {
    email: String!
    password: String!
}

# ---------------------------------------------------------------- vehicles

enum FuelType { PETROL DIESEL HYBRID ELECTRIC LPG }
enum Transmission { MANUAL AUTOMATIC }
enum BodyType { SEDAN HATCHBACK SUV PICKUP VAN COUPE WAGON OTHER }
enum VehicleCondition { NEW FOREIGN_USED LOCALLY_USED }
enum VehicleStatus { AVAILABLE RESERVED SOLD UNAVAILABLE }
enum VehicleSort { NEWEST PRICE_ASC PRICE_DESC YEAR_DESC MILEAGE_ASC }
enum EnquiryType { GENERAL VIEWING }
enum EnquiryStatus { NEW CONTACTED VIEWING_SCHEDULED CLOSED_WON CLOSED_LOST }

type Vehicle {
    id: ID!
    slug: String!
    title: String!
    make: String!
    model: String!
    variant: String
    year: Int!
    mileageKm: Int
    fuelType: FuelType!
    transmission: Transmission!
    bodyType: BodyType!
    color: String
    condition: VehicleCondition!
    engineCapacityCc: Int
    engineCode: String
    "Yard or branch where the vehicle is located."
    location: String
    description: String
    price: Money!
    status: VehicleStatus!
    published: Boolean!
    "Whether a general enquiry can currently be submitted."
    enquiriesOpen: Boolean!
    "Whether a viewing can currently be requested."
    viewingsOpen: Boolean!
    features: [String!]!
    images: [VehicleImage!]!
    publishedAt: DateTime
    createdAt: DateTime!
    updatedAt: DateTime!
    "Staff only; always null on public queries."
    registrationNumber: String
    "Staff only; null on public queries."
    statusHistory: [VehicleStatusChange!]
}

type VehicleImage {
    id: ID!
    url: String!
    altText: String!
    sortOrder: Int!
}

type VehicleStatusChange {
    fromStatus: VehicleStatus
    toStatus: VehicleStatus!
    changedAt: DateTime!
}

type VehiclePage {
    items: [Vehicle!]!
    totalCount: Int!
    page: Int!
    size: Int!
    totalPages: Int!
}

input VehicleFilter {
    search: String
    make: String
    model: String
    minYear: Int
    maxYear: Int
    "Decimal string, e.g. \"25000000\""
    minPrice: String
    maxPrice: String
    maxMileageKm: Int
    fuelType: FuelType
    transmission: Transmission
    bodyType: BodyType
    condition: VehicleCondition
    includeSold: Boolean
}

input AdminVehicleFilter {
    search: String
    status: VehicleStatus
    published: Boolean
}

input VehicleInput {
    make: String!
    model: String!
    variant: String
    year: Int!
    mileageKm: Int
    fuelType: FuelType!
    transmission: Transmission!
    bodyType: BodyType!
    color: String
    condition: VehicleCondition!
    engineCapacityCc: Int
    "e.g. 1KD-FTV, 2TR-FE"
    engineCode: String
    "Yard or branch where the vehicle is located."
    location: String
    description: String
    registrationNumber: String
    "Decimal string in the business currency (TZS)."
    priceAmount: String!
    features: [String!]
}

input VehicleImageInput {
    url: String!
    altText: String!
    sortOrder: Int
}

type VehicleSummary {
    id: ID!
    slug: String!
    title: String!
    status: VehicleStatus!
}

type SalesEnquiry {
    id: ID!
    reference: String!
    vehicle: VehicleSummary!
    type: EnquiryType!
    fullName: String!
    email: String!
    phone: String!
    message: String
    preferredViewingAt: DateTime
    status: EnquiryStatus!
    assignedToUserId: ID
    createdAt: DateTime!
}

type SalesEnquiryPage {
    items: [SalesEnquiry!]!
    totalCount: Int!
    page: Int!
    size: Int!
    totalPages: Int!
}

input VehicleEnquiryInput {
    vehicleId: ID!
    type: EnquiryType!
    fullName: String!
    email: String!
    phone: String!
    message: String
    preferredViewingAt: DateTime
}

input UpdateEnquiryInput {
    status: EnquiryStatus!
    assignedToUserId: ID
}

# ---------------------------------------------------------------- services

enum PriceType { FIXED STARTING_FROM HOURLY INSPECTION_REQUIRED QUOTE_REQUIRED }

type ServiceCategory {
    id: ID!
    slug: String!
    name: String!
    description: String
    sortOrder: Int!
}

type Service {
    id: ID!
    slug: String!
    name: String!
    summary: String!
    description: String
    category: ServiceCategory!
    priceType: PriceType!
    "Null for INSPECTION_REQUIRED and QUOTE_REQUIRED services."
    price: Money
    durationMinutes: Int
    active: Boolean!
    sortOrder: Int!
}

input ServiceCategoryInput {
    name: String!
    description: String
    sortOrder: Int
}

input ServiceInput {
    categoryId: ID!
    name: String!
    summary: String!
    description: String
    priceType: PriceType!
    priceAmount: String
    durationMinutes: Int
    active: Boolean
    sortOrder: Int
}

# ---------------------------------------------------------------- contact

enum ContactEnquiryStatus { NEW IN_PROGRESS RESOLVED }

type ContactEnquiry {
    id: ID!
    reference: String!
    fullName: String!
    email: String!
    phone: String
    subject: String!
    message: String!
    status: ContactEnquiryStatus!
    createdAt: DateTime!
}

type ContactEnquiryPage {
    items: [ContactEnquiry!]!
    totalCount: Int!
    page: Int!
    size: Int!
    totalPages: Int!
}

input ContactEnquiryInput {
    fullName: String!
    email: String!
    phone: String
    subject: String!
    message: String!
}

# ---------------------------------------------------------------- rentals

enum RentalVehicleStatus { AVAILABLE UNAVAILABLE }
enum ReservationStatus { PENDING CONFIRMED ACTIVE COMPLETED CANCELLED }

type RentalVehicle {
    id: ID!
    slug: String!
    title: String!
    make: String!
    model: String!
    variant: String
    year: Int!
    seats: Int
    fuelType: FuelType!
    transmission: Transmission!
    bodyType: BodyType!
    color: String
    "Pickup point or yard."
    location: String
    description: String
    dailyRate: Money!
    deposit: Money
    status: RentalVehicleStatus!
    published: Boolean!
    images: [VehicleImage!]!
    publishedAt: DateTime
    createdAt: DateTime!
    updatedAt: DateTime!
    "Staff only; null on public queries."
    registrationNumber: String
}

type RentalVehiclePage {
    items: [RentalVehicle!]!
    totalCount: Int!
    page: Int!
    size: Int!
    totalPages: Int!
}

type RentalVehicleSummary {
    id: ID!
    slug: String!
    title: String!
}

type RentalAvailability {
    available: Boolean!
    days: Int!
    dailyRate: Money!
    total: Money!
}

type Reservation {
    id: ID!
    reference: String!
    vehicle: RentalVehicleSummary!
    fullName: String!
    email: String!
    phone: String!
    startDate: Date!
    endDate: Date!
    days: Int!
    status: ReservationStatus!
    dailyRate: Money!
    total: Money!
    notes: String
    createdAt: DateTime!
}

type ReservationPage {
    items: [Reservation!]!
    totalCount: Int!
    page: Int!
    size: Int!
    totalPages: Int!
}

input RentalVehicleInput {
    make: String!
    model: String!
    variant: String
    year: Int!
    seats: Int
    fuelType: FuelType!
    transmission: Transmission!
    bodyType: BodyType!
    color: String
    "Pickup point or yard."
    location: String
    description: String
    registrationNumber: String
    "Decimal string in the business currency (TZS)."
    dailyRateAmount: String!
    depositAmount: String
}

input AdminRentalFilter {
    search: String
    status: RentalVehicleStatus
    published: Boolean
}

input ReservationInput {
    rentalVehicleId: ID!
    fullName: String!
    email: String!
    phone: String!
    startDate: Date!
    endDate: Date!
    notes: String
    "Client-generated idempotency key: resubmitting returns the original reservation."
    requestToken: ID
}

input UpdateReservationInput {
    status: ReservationStatus!
}

# ---------------------------------------------------------------- workshop bookings

enum BookingStatus { PENDING CONFIRMED IN_PROGRESS COMPLETED CANCELLED NO_SHOW }

type ServiceBooking {
    id: ID!
    reference: String!
    service: BookedServiceSummary!
    fullName: String!
    email: String!
    phone: String!
    vehicleDescription: String!
    scheduledStart: DateTime!
    scheduledEnd: DateTime!
    status: BookingStatus!
    notes: String
    createdAt: DateTime!
}

type BookedServiceSummary {
    id: ID!
    slug: String!
    name: String!
    category: String!
}

type ServiceBookingPage {
    items: [ServiceBooking!]!
    totalCount: Int!
    page: Int!
    size: Int!
    totalPages: Int!
}

type WorkshopCapacity {
    maxConcurrentJobs: Int!
}

input BookingInput {
    serviceId: ID!
    fullName: String!
    email: String!
    phone: String!
    "e.g. \"2018 Toyota Corolla, T 123 ABC\""
    vehicleDescription: String!
    scheduledStart: DateTime!
    notes: String
    requestToken: ID
}

input UpdateBookingInput {
    status: BookingStatus!
}

input CapacityInput {
    maxConcurrentJobs: Int!
}

# ---------------------------------------------------------------- quotations

enum WorkType { PAINTING COLOUR_CHANGE DETAILING RESTORATION REPAIR MAINTENANCE ACCESSORIES OTHER }
enum QuotationStatus { REQUESTED QUOTED ACCEPTED DECLINED EXPIRED CANCELLED }

type Quotation {
    id: ID!
    reference: String!
    serviceName: String
    fullName: String!
    email: String!
    phone: String!
    workType: WorkType!
    vehicleDescription: String!
    description: String!
    status: QuotationStatus!
    quotedAmount: Money
    validUntil: Date
    staffNotes: String
    decidedAt: DateTime
    createdAt: DateTime!
}

type QuotationPage {
    items: [Quotation!]!
    totalCount: Int!
    page: Int!
    size: Int!
    totalPages: Int!
}

input QuotationRequestInput {
    serviceId: ID
    fullName: String!
    email: String!
    phone: String!
    workType: WorkType!
    vehicleDescription: String!
    "Describe the work you need done."
    description: String!
    requestToken: ID
}

input QuoteInput {
    quotedAmount: String!
    validUntil: Date!
    staffNotes: String
}

# ---------------------------------------------------------------- workshop jobs

enum JobStatus { SCHEDULED IN_PROGRESS ON_HOLD COMPLETED CANCELLED }

type WorkshopJob {
    id: ID!
    reference: String!
    booking: JobBookingSummary
    vehicleDescription: String!
    description: String!
    status: JobStatus!
    assignedToUserId: ID
    scheduledFor: DateTime
    laborNotes: String
    createdAt: DateTime!
}

type JobBookingSummary {
    id: ID!
    reference: String!
    serviceName: String!
}

type WorkshopJobPage {
    items: [WorkshopJob!]!
    totalCount: Int!
    page: Int!
    size: Int!
    totalPages: Int!
}

input CreateJobInput {
    bookingId: ID
    vehicleDescription: String!
    description: String!
    scheduledFor: DateTime
    assignedToUserId: ID
}

input UpdateJobInput {
    description: String
    scheduledFor: DateTime
    assignedToUserId: ID
    laborNotes: String
}

# ---------------------------------------------------------------- accessories, stock, orders

enum StockReason { ORDER_PLACED ORDER_CANCELLED ADJUSTMENT RESTOCK }
enum OrderStatus { PENDING CONFIRMED READY COMPLETED CANCELLED }

type Accessory {
    id: ID!
    sku: String!
    name: String!
    category: String
    description: String
    price: Money!
    stockQuantity: Int!
    active: Boolean!
    inStock: Boolean!
    createdAt: DateTime!
}

type AccessoryPage {
    items: [Accessory!]!
    totalCount: Int!
    page: Int!
    size: Int!
    totalPages: Int!
}

type StockMovement {
    id: ID!
    delta: Int!
    reason: StockReason!
    orderId: ID
    actorUserId: ID
    note: String
    createdAt: DateTime!
}

type Order {
    id: ID!
    reference: String!
    fullName: String!
    email: String!
    phone: String!
    status: OrderStatus!
    total: Money!
    notes: String
    items: [OrderItem!]!
    createdAt: DateTime!
}

type OrderItem {
    id: ID!
    description: String!
    unitPrice: Money!
    quantity: Int!
    lineTotal: Money!
}

type OrderPage {
    items: [Order!]!
    totalCount: Int!
    page: Int!
    size: Int!
    totalPages: Int!
}

input AccessoryInput {
    sku: String
    name: String!
    category: String
    description: String
    priceAmount: String!
    stockQuantity: Int!
    active: Boolean!
}

input StockAdjustInput {
    delta: Int!
    reason: StockReason!
    note: String
}

input OrderItemInput {
    accessoryId: ID!
    quantity: Int!
}

input OrderInput {
    items: [OrderItemInput!]!
    fullName: String!
    email: String!
    phone: String!
    notes: String
    requestToken: ID
}

# ---------------------------------------------------------------- invoices & payments

enum InvoiceStatus { DRAFT ISSUED PAID VOID }
enum PaymentMethod { CASH CARD BANK_TRANSFER MPESA TIGOPESA AIRTEL_MONEY }

type Invoice {
    id: ID!
    reference: String!
    recipientName: String!
    recipientEmail: String!
    status: InvoiceStatus!
    total: Money!
    paid: Money!
    balance: Money!
    dueDate: Date
    issuedAt: DateTime
    paidAt: DateTime
    notes: String
    bookingId: ID
    orderId: ID
    quotationId: ID
    items: [InvoiceItem!]!
    payments: [Payment!]!
    createdAt: DateTime!
}

type InvoiceItem {
    id: ID!
    description: String!
    quantity: Int!
    unitPrice: Money!
    lineTotal: Money!
}

type Payment {
    id: ID!
    amount: Money!
    method: PaymentMethod!
    reference: String
    paidAt: DateTime!
    note: String
}

type InvoicePage {
    items: [Invoice!]!
    totalCount: Int!
    page: Int!
    size: Int!
    totalPages: Int!
}

input InvoiceItemInput {
    description: String!
    quantity: Int!
    unitPrice: String!
}

input InvoiceInput {
    customerUserId: ID
    recipientName: String!
    recipientEmail: String!
    items: [InvoiceItemInput!]!
    bookingId: ID
    orderId: ID
    quotationId: ID
    dueDate: Date
    notes: String
}

input PaymentInput {
    amount: String!
    method: PaymentMethod!
    reference: String
    paidAt: DateTime
    note: String
    requestToken: ID
}
