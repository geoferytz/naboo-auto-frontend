# Copy to .env and replace every placeholder. Never commit .env.
# These values are placeholders only and must not be used in production.

SPRING_PROFILES_ACTIVE=dev

POSTGRES_DB=naboo_automotive
POSTGRES_USER=naboo_app
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_SECRET
DB_HOST=localhost
DB_PORT=5432

# Base64-encoded secret of at least 32 bytes, e.g. `openssl rand -base64 48`
JWT_SECRET=REPLACE_WITH_BASE64_SECRET
JWT_TTL_MINUTES=120

APP_PUBLIC_URL=http://localhost:4200
APP_CORS_ORIGINS=http://localhost:4200
APP_TIMEZONE=Africa/Dar_es_Salaam
APP_CURRENCY=TZS

# Optional: creates the first SUPER_ADMIN on startup when none exists.
# Remove after the first admin account exists.
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=
APP_BOOTSTRAP_ADMIN_NAME=Naboo Administrator

PAYMENT_PROVIDER=disabled
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=

STORAGE_PROVIDER=local
