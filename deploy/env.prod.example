# Production environment — copy to .env.prod on the server (never commit the real file).

POSTGRES_DB=naboo_automotive
POSTGRES_USER=naboo_app
POSTGRES_PASSWORD=   # generate: openssl rand -hex 24

JWT_SECRET=          # generate: openssl rand -hex 48
JWT_TTL_MINUTES=120

# Optional first-boot admin account (remove or rotate after creating real staff users).
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=
APP_BOOTSTRAP_ADMIN_NAME=Naboo Administrator

BACKUP_RETENTION_DAYS=30
