# syntax=docker/dockerfile:1
# Builds the Angular bundle and serves it behind the TLS proxy.
FROM node:22-alpine AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ .
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist/naboo-frontend/browser /usr/share/nginx/html
COPY deploy/nginx-main.conf /etc/nginx/nginx.conf
ARG NGINX_CONF=deploy/nginx.conf
COPY ${NGINX_CONF} /etc/nginx/conf.d/default.conf
EXPOSE 80 443
